# Core
SECRET_KEY=REPLACE_ME
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# App
BASE_URL=http://127.0.0.1:8000

# Timeline testing (optional)
TIME_COMPRESSION=True
SECONDS_PER_DAY=10

# Email
# Option A: SendGrid (production) — set SENDGRID_API_KEY and SendGrid takes over
# SENDGRID_API_KEY=SG.xxxxxx
# DEFAULT_FROM_EMAIL=The Confident Moves Research Team <noreply@yourdomain.org>

# Option B: SMTP fallback (local dev / no SendGrid)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your_user
# EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Celery/Redis (optional)
# REDIS_URL=redis://localhost:6379/0
