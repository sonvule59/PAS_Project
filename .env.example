# Core
SECRET_KEY=REPLACE_ME
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# App
BASE_URL=http://127.0.0.1:8000

# Timeline testing (optional)
TIME_COMPRESSION=True
SECONDS_PER_DAY=10

# Email
# Option A: Mailgun HTTP API (production) — set these and Mailgun takes over
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_SENDER_DOMAIN=sandboxXXXX.mailgun.org
# DEFAULT_FROM_EMAIL=The Confident Moves Research Team <noreply@yourdomain.mailgun.org>

# Option B: SMTP fallback (local dev / no Mailgun)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your_user
# EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Celery/Redis (optional)
# REDIS_URL=redis://localhost:6379/0
